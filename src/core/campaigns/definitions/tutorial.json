{
  "schemaVersion": 2,
  "id": "tutorial",
  "name": "Tutorial Campaign",
  "missions": [
    {
      "id": "selection-and-movement",
      "name": "Selection and Movement",
      "builtInMapId": "tutorial-movement-12x5",
      "conditions": {
        "type": "standard-match-or-reach-cell",
        "unit": {
          "type": "any"
        },
        "cell": {
          "x": 11,
          "y": 2
        },
        "mapBinding": "tutorial-movement-12x5"
      },
      "events": [
        {
          "id": "introduction",
          "type": "dialogue",
          "trigger": {
            "type": "mission-start"
          },
          "lines": [
            {
              "speaker": "Instructor",
              "text": "Welcome! Click either Blue infantry unit to select it. Use the mouse wheel to zoom and WASD or arrow keys to pan the map.",
              "id": "line-1"
            }
          ]
        },
        {
          "id": "selection",
          "type": "dialogue",
          "trigger": {
            "type": "unit-selected",
            "unit": {
              "type": "any"
            },
            "mapBinding": "tutorial-movement-12x5"
          },
          "lines": [
            {
              "speaker": "Instructor",
              "text": "Your unit is selected. Highlighted cells are available destinations. Close this dialogue and click an available cell to move.",
              "id": "line-1"
            }
          ]
        },
        {
          "id": "movement",
          "type": "dialogue",
          "trigger": {
            "type": "unit-moved",
            "unit": {
              "type": "any"
            },
            "mapBinding": "tutorial-movement-12x5"
          },
          "lines": [
            {
              "speaker": "Instructor",
              "text": "Moving spends movement points. You can move again while points remain. Click END TURN to restore movement; the empty Red turn ends automatically. Reach the marked goal at (11, 2) on the right edge with either Blue unit.",
              "id": "line-1"
            }
          ]
        },
        {
          "id": "completion",
          "type": "dialogue",
          "trigger": {
            "type": "mission-end"
          },
          "lines": [
            {
              "speaker": "Instructor",
              "text": "Well done! You have learned to select units, move them, and end the turn. You reached the far edge and completed this lesson.",
              "id": "line-1"
            }
          ]
        }
      ]
    }
  ]
}
